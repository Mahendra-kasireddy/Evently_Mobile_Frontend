# ---------------------------------------------------------------------------
# All backend base URLs live here, matching evently-FrontEnd's env pattern.
# src/services/env.ts picks the one matching the active build (__DEV__ only
# distinguishes development vs. production today — no QA channel switch yet).
#
# These are hostnames, not secrets — do NOT put real credentials/keys here.
# ---------------------------------------------------------------------------

API_BASE_URL_DEVELOPMENT=http://localhost:3000/api
API_BASE_URL_QA=https://qa-api.evently.example.com/api
API_BASE_URL_PRODUCTION=https://api.evently.example.com/api

APP_NAME=Evently
